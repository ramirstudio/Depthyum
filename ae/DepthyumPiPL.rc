// Pre-generated PiPL resource for Depthyum (the layout PiPLtool produces from DepthyumPiPL.r, macros
// expanded), same approach as Lensyum. Keep it in sync with DepthyumPiPL.r and with the flags in
// GlobalSetup. The Pascal strings use octal length bytes (\010, \016, \047) because a hex escape
// would swallow the first letter of the name when it is a hex digit (the D of Depthyum).
16000  PiPL  DISCARDABLE
BEGIN
        0x0001,
        0, 0x0,             /* version */
        13, 0x0,            /* property count */

        "MIB8",
        "dnik",             /* kind */
        0, 0x0,
        4, 0x0,
        "TKFe",

        "MIB8",
        "eman",             /* name */
        0, 0x0,
        12, 0x0,
        "\010Depthyum\0\0\0",

        "MIB8",
        "gtac",             /* category */
        0, 0x0,
        12, 0x0,
        "\010Depthyum\0\0\0",

        "MIB8",
        "4668",             /* Win64 x86 code entry */
        0, 0x0,
        12, 0x0,
        "EffectMain\0\0",

        "MIB8",
        "RVPe",             /* PiPL version */
        0, 0x0,
        4, 0x0,
        2, 0,

        "MIB8",
        "RVSe",             /* effect spec version */
        0, 0x0,
        4, 0x0,
        13, 29,

        "MIB8",
        0x65564552L,        /* eVER: effect version */
        0L,
        4L,
        525825L,           /* PF_VERSION(1, 0, 0, PF_Stage_RELEASE, 1) */

        "MIB8",
        0x65494E46L,        /* eINF: info flags */
        0L,
        2L,
        0L,

        "MIB8",
        "OLGe",             /* global out flags */
        0L,
        4L,
        33554438L,          /* DEEP_COLOR_AWARE | WIDE_TIME_INPUT | NON_PARAM_VARY */

        "MIB8",
        "2LGe",             /* global out flags 2 */
        0L,
        4L,
        134222848L,         /* SUPPORTS_SMART_RENDER | FLOAT_COLOR_AWARE | SUPPORTS_THREADED_RENDERING */

        "MIB8",
        "ANMe",             /* match name */
        0, 0x0,
        16, 0x0,
        "\016RAMIR Depthyum\0",

        "MIB8",
        0x6165464CL,        /* aeFL */
        0L,
        4L,
        0L,

        "MIB8",
        "LRUe",             /* support URL */
        0, 0x0,
        40, 0x0,
        "\047https://github.com/ramirstudio/Depthyum"
END
