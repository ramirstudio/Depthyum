        <UI>
          <Type>Panel</Type>
          <Menu>Depthyum</Menu>
          <Geometry>
            <Size>
              <Width>320</Width>
              <Height>560</Height>
            </Size>
            <MinSize>
              <Width>260</Width>
              <Height>420</Height>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
